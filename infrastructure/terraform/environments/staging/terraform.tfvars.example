# Copy to terraform.tfvars and fill in.
#
# No secret belongs here. Values live in Secret Manager, written by
# infrastructure/scripts/provision-secrets.sh.
#
# Staging is production's architecture at a smaller size. What differs is
# quantity — instance size, instance counts, backup depth — never composition.
# ADR-0007 requires environment separation to include stateful resources and
# secrets, so nothing below may point at a dev database, bucket or secret.

project_id = "your-staging-gcp-project-id"

region = "us-central1"

image = "us-central1-docker.pkg.dev/your-staging-gcp-project-id/care-staging/care@sha256:REPLACE_ME"

# Sizing. Defaults are deliberately modest; raise them from observed load
# rather than in anticipation of it.
# sql_tier         = "db-g1-small"
# sql_disk_size_gb = 20

# api_max_instances               = 4
# worker_max_instances            = 3
# tasks_max_concurrent_dispatches = 8

django_allowed_hosts = ["care-staging.example.org"]
csrf_trusted_origins = ["https://care-staging.example.org"]
cors_allowed_origins = ["https://care-staging.example.org"]
current_domain       = "care-staging.example.org"

# alerts_enabled = true
# alert_notification_channels = ["projects/your-staging-gcp-project-id/notificationChannels/1234567890"]

# optional_secrets = {
#   SENTRY_DSN = ["api", "worker", "init"]
# }

# --- Email -------------------------------------------------------------------
# Nothing needs to be set here. Staging defaults to Django's console backend,
# which is a valid runtime configuration: the API enqueues, Cloud Tasks
# delivers, the worker renders the message and it lands in Cloud Logging.
# External delivery is intentionally absent and is an optional operational
# capability (docs/xii/architecture/inventory/unresolved-items.md N1).
#
# To enable external delivery, uncomment all three blocks and fill in the relay
# you chose. This repository names no provider and holds no credential; the
# values below are placeholders showing shape only.
#
# django_email_backend = ""   # restores Django's SMTP backend
#
# extra_env = {
#   EMAIL_HOST    = "smtp.your-relay.example"
#   EMAIL_PORT    = "587"
#   EMAIL_USER    = "your-relay-username"
#   EMAIL_USE_TLS = "true"     # or EMAIL_USE_SSL = "true" on 465; never both
#   EMAIL_FROM    = "CARE <no-reply@care-staging.example.org>"
# }
#
# optional_secrets = {
#   EMAIL_PASSWORD = ["api", "worker"]
#   SENTRY_DSN     = ["api", "worker", "init"]
# }
#
# That declares the Secret Manager container and its per-role IAM. The value is
# written separately, and never into this file or any other tracked one:
#
#   gcloud secrets versions add care-staging-email-password --data-file=-
