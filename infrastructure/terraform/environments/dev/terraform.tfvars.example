# Copy to terraform.tfvars and fill in.
#
# Nothing secret belongs in this file. Secrets live in Secret Manager and are
# written by infrastructure/scripts/provision-secrets.sh; OpenTofu never sees a
# value (ES-07 section 70).

project_id = "your-gcp-project-id"

region = "us-central1"

# The published CARE image. Prefer a digest — a moving tag makes it impossible
# to say afterwards what was deployed.
#
#   us-central1-docker.pkg.dev/<project>/care-dev/care@sha256:<digest>
image = "us-central1-docker.pkg.dev/your-gcp-project-id/care-dev/care:REPLACE_ME"

# Cloud Run's generated hostname is covered by the .run.app suffix the module
# adds. List custom domains only.
# django_allowed_hosts = ["care-dev.example.org"]

# Browser origins that may call the API.
# cors_allowed_origins = ["https://care-dev.example.org"]
# csrf_trusted_origins = ["https://care-dev.example.org"]

# Frontend host used in outbound email links.
# current_domain = "care-dev.example.org"

# Extra secrets to create, as env var name => roles that may read it.
# optional_secrets = {
#   EMAIL_PASSWORD = ["api", "worker"]
#   SENTRY_DSN     = ["api", "worker", "init"]
# }

# Direct Firebase patient login. This needs no server-side Firebase secret.
# extra_env = {
#   FIREBASE_AUTH_ENABLED           = "true"
#   FIREBASE_AUTH_PROJECT_ID        = "your-firebase-project-id"
#   FIREBASE_AUTH_SMS_COUNTRY_CODES = "+52"
# }

# Keycloak is dormant by default. When a server exists, add these non-secret
# values to extra_env and create the two API-only secret containers below.
# No application code change is required.
# extra_env = {
#   KEYCLOAK_ENABLED             = "true"
#   KEYCLOAK_ISSUER_URL          = "https://identity.example/realms/care"
#   KEYCLOAK_WORKFORCE_CLIENT_ID = "care-workforce"
#   KEYCLOAK_PATIENT_CLIENT_ID   = "care-patient"
#   KEYCLOAK_PUBLIC_BASE_URL     = "https://care-dev.example.org"
# }
# optional_secrets = {
#   KEYCLOAK_WORKFORCE_CLIENT_SECRET = ["api"]
#   KEYCLOAK_PATIENT_CLIENT_SECRET   = ["api"]
# }

# Development data. Creates a Job that seeds synthetic accounts and clinical
# records; you execute it by hand, and it is destructive to what is already
# there. Dev only — the module rejects it elsewhere. See README section 7.8.
#
# The image is a thin layer over the runtime image that adds Faker:
#   publish-image.sh --fixtures-from <runtime-image@sha256:...>
# enable_fixture_loader = true
# fixture_image = "us-central1-docker.pkg.dev/your-gcp-project-id/care-dev/care-fixtures@sha256:<digest>"
